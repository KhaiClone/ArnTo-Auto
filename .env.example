TOKEN=

# Bank (VietQR)
BANK_CODE=
BANK_ACCOUNT=
BANK_HOLDER=
QUEST_PRICE_PER_ITEM=
# Monthly Auto Quest subscription (flat price per 30-day month)
MONTHLY_QUEST_PRICE=50000
# Hour (0-23, VN time) the monthly batch runs (completes quests) on Tue & Sat
MONTHLY_RUN_HOUR=9
# Hour (0-23, VN time) of the DAILY enroll-only scan for monthly accounts
MONTHLY_ENROLL_HOUR=3

# Channels
VIETQR_CHANNEL_ID=
LOG_WEBHOOK_URL=
QUEST_ORDER_LOG_CHANNEL_ID=
# Kenh nhan thong bao moi khi xong 1 quest (de trong = DM cho khach nhu cu)
QUEST_NOTIFY_CHANNEL_ID=
ROBUX_ORDER_LOG_CHANNEL_ID=
ROBUX_QUEUE_CHANNEL_ID=

# Optional
EXPRESS=false
WEBHOOK_BACKUP=

# ── bot-panel ────────────────────────────────────────────────────────────────
# The panel gateway on this node, and THIS project's own key (Panel Settings →
# API Keys). The panel never calls this bot: quest/badge events and DMs arrive
# over its private Discord channel (extensions/PanelBus.js).
PANEL_API_URL=http://127.0.0.1:4201
PANEL_API_KEY=
# Server of the panel's command channel — the bot must not leave it.
PANEL_BUS_GUILD_ID=

# Quest execution via panel: when true, arnto-auto keeps payment but delegates
# running quests to the bot-panel (needs PANEL_API_URL + PANEL_API_KEY above).
PANEL_QUEST=false

# ── Auto Badge (chay tren bot-panel) ─────────────────────────────────────────
PANEL_BADGE=false
BADGE_ORDER_LOG_CHANNEL_ID=

# ── Auto Deco Gift (/dg-setup) ───────────────────────────────────────────────
# Danh sach deco + len don Shop + gui link deu qua bot-panel (can PANEL_API_URL/KEY).
# Kenh staff nhan don da thanh toan (nut Duyet / Huy, chi Administrator). De trong = tat.
DECO_GIFT_STAFF_CHANNEL_ID=
# Seller tinh don (mac dinh KhaiDev)
DECO_GIFT_SELLER_ID=871329074046435338
