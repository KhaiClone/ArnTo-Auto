TOKEN=

# Bank (VietQR)
BANK_CODE=
BANK_ACCOUNT=
BANK_HOLDER=
QUEST_PRICE_PER_ITEM=
# Monthly Auto Quest subscription (flat price per 30-day month)
MONTHLY_QUEST_PRICE=50000
# Hour (0-23, VN time) the monthly batch runs (completes quests) on Tue & Sat
MONTHLY_RUN_HOUR=9
# Hour (0-23, VN time) of the DAILY enroll-only scan for monthly accounts
MONTHLY_ENROLL_HOUR=3

# Channels
VIETQR_CHANNEL_ID=
LOG_WEBHOOK_URL=
QUEST_ORDER_LOG_CHANNEL_ID=
ROBUX_ORDER_LOG_CHANNEL_ID=
ROBUX_QUEUE_CHANNEL_ID=

# Optional
EXPRESS=false
WEBHOOK_BACKUP=

# Panel Integration
PANEL_API_URL=http://localhost:3000
PANEL_API_KEY=your_secure_secret_key

# DM API (panel -> arnto-auto). Set DM_API_KEY to enable POST /api/dm.
# The HTTP listener also auto-starts when this is set (EXPRESS not required).
DM_API_KEY=

# Quest execution via panel: when true, arnto-auto keeps payment but delegates
# running quests to the bot-panel (needs PANEL_API_URL + PANEL_API_KEY above).
PANEL_QUEST=false
# arnto-auto's own reachable URL where the panel POSTs quest events (webhook).
# Requires the HTTP listener (DM_API_KEY or EXPRESS=true) to be enabled.
PANEL_QUEST_WEBHOOK_URL=http://localhost:3000/api/quest-event

# ── Auto Badge (chay tren bot-panel) ─────────────────────────────────────────
PANEL_BADGE=false
# URL panel goi nguoc ve khi don co tien trien (cung listener voi PANEL_QUEST_WEBHOOK_URL)
PANEL_BADGE_WEBHOOK_URL=http://localhost:3000/api/badge-event
BADGE_ORDER_LOG_CHANNEL_ID=
